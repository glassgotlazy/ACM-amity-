# Where form submissions are delivered.
#
# Leave this unset and the site still works: the forms validate, animate and
# confirm, but nothing is transmitted and every confirmation screen says so.
# Set it and submissions start arriving at the destination.
#
# This is a SERVER-ONLY variable. It is never exposed to the browser, so a
# destination URL that contains a key stays private. Do not rename it with a
# NEXT_PUBLIC_ prefix.
#
# Any endpoint that accepts a JSON POST works. Examples:
#   Formspree   https://formspree.io/f/xxxxxxxx
#   Tally       https://api.tally.so/webhooks/xxxxxxxx
#   Make/Zapier a catch-hook URL
#   Your own    https://your-service.example/acm-submissions
#
FORM_ENDPOINT=

# Gates /admin. Leave unset and the admin view is unreachable (fails closed).
# Set it and /admin asks for this password once per browser, for 12 hours.
# Server-only, like FORM_ENDPOINT — never prefix with NEXT_PUBLIC_.
ADMIN_PASSWORD=

# Submission storage (Supabase). Both server-only — never NEXT_PUBLIC_.
# Project URL and the *service_role* key from Settings → API. Run
# supabase/schema.sql once in the SQL editor. With these set, every form
# submission is stored and appears in /admin; FORM_ENDPOINT can stay as a
# second copy to an inbox, or be removed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
